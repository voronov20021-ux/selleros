# SellerOS — переменные окружения
# Скопируйте в .env и заполните. Кодировка ТОЛЬКО UTF-8.
# Каждая переменная должна встречаться один раз.

# --- Telegram ---
BOT_TOKEN=
# Максимальный возраст Telegram WebApp initData (секунды). По умолчанию 86400 (24ч).
# TELEGRAM_AUTH_MAX_AGE=86400
# TTL opaque Mini App session (секунды). По умолчанию 604800 (7 дней).
# AUTH_SESSION_TTL_SECONDS=604800
# Encryption key for seller WB API credentials at rest (onboarding).
# If empty, derived from BOT_TOKEN (dev only). Prefer a dedicated secret in prod.
# SELLER_SECRETS_KEY=

# --- Mini App local DEV preview (NEVER enable in production) ---
# Default is off. POST /api/auth/dev only works when this is 1 AND the
# request Host/Origin/client is localhost or 127.0.0.1. APP_ENV=production
# refuses DEV auth even on localhost. Does not weaken Telegram HMAC.
# MINIAPP_DEV_AUTH=0
# APP_ENV=development
# Public HTTPS origin of the existing Mini App (GitHub Pages). Used only
# for the Telegram button that opens /#/products/{nmID}. Empty = hide button.
# MINIAPP_PUBLIC_URL=
# Extra API CORS origins (comma-separated). Never use *. Pages origin is already allowed.
# CORS_ORIGINS=https://your-amvera-host.example

# --- Seller AI ---
# Кто работает под капотом: claude | openai | gemini | off
AI_PROVIDER=claude

# VseGPT — шлюз к Claude и другим моделям (оплата в рублях, работает из РФ).
# Ключ: https://vsegpt.ru/User/API
VSEGPT_API_KEY=

# Модель Claude. Каталог: https://vsegpt.ru/Docs/Models
CLAUDE_MODEL=anthropic/claude-sonnet-5

# --- Необязательное ---
# VSEGPT_BASE_URL=https://api.vsegpt.ru/v1
# OPENAI_MODEL=openai/gpt-4o-mini
# AI_TIMEOUT=45
# AI_MAX_TOKENS=1500
# AI_TEMPERATURE=0.7
# GEMINI_API_KEY=

# --- BrowserProvider (PRIORITY №1) — ОТДЕЛЬНЫЙ HTTP proxy ---
# Chromium/Playwright: ТОЛЬКО HTTP. Authenticated SOCKS5 НЕ поддерживается.
# Формат Playwright: server=http://HOST:PORT + username/password отдельно.
# НЕ кладите сюда WB SOCKS5 (WB_PROXY / WB_PROXY_URLS). Без auto-swap socks→http.
# После покупки HTTP proxy: python scripts/browser_health.py
#
# Альтернатива: локальный SOCKS5→HTTP CONNECT bridge (ниже SOCKS_BRIDGE_*).
# При SOCKS_BRIDGE_ENABLED=1 BrowserProvider берёт http://127.0.0.1:8080.
BROWSER_ENABLED=1
BROWSER_HEADLESS=1
BROWSER_PROXY=http://LOGIN:PASSWORD@HOST:PORT
# Несколько HTTP proxies (запятая и/или переносы). Rotation + health (BrowserProxyPool).
# BROWSER_PROXY_LIST=http://u1:p1@h1:8080,http://u2:p2@h2:8080
BROWSER_PROXY_SCHEME=http
BROWSER_PROXY_MODE=sticky
# BROWSER_TIMEOUT — миллисекунды (Playwright page timeout). Alias: BROWSER_TIMEOUT_MS в коде.
BROWSER_TIMEOUT=60000
BROWSER_DISABLE_HTTP2=true
# Установленный Google Chrome + CDP (не Playwright Chromium). Default=1.
# Windows/local: 1. Amvera python:3 image usually has no google-chrome → code
# falls back to Playwright bundled Chromium. Set 0 to skip the lookup.
BROWSER_USE_SYSTEM_CHROME=1
# BROWSER_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Amvera persistent disk for `playwright install chromium` (not used at Docker BUILD).
# PLAYWRIGHT_BROWSERS_PATH=/data/ms-playwright
# PYTHONUNBUFFERED=1
# BROWSER_CACHE_TTL=7d
# BROWSER_CACHE_PATH=data/browser_public_cache.db

# --- SOCKS5 → HTTP CONNECT bridge (для Chromium) ---
# Playwright → http://127.0.0.1:8080 → authenticated SOCKS5 upstream.
# WBEngine / WB_PROXY* на bridge НЕ переключаются (остаются на прямом SOCKS5).
SOCKS_BRIDGE_ENABLED=0
SOCKS_BRIDGE_HOST=127.0.0.1
SOCKS_BRIDGE_PORT=8080
SOCKS_UPSTREAM_HOST=HOST
SOCKS_UPSTREAM_PORT=PORT
SOCKS_UPSTREAM_USER=LOGIN
SOCKS_UPSTREAM_PASSWORD=PASSWORD

# --- WB Engine / HTTP слой (PROXY #2) — отдельно от Browser ---
# Обычно SOCKS5 (Proxy6net). BrowserProvider эти URL НЕ читает.
# WB_PROXY_SCHEME=socks5  → socks5h://...
# WB_PROXY_SCHEME=http    → http://...
WB_PROXY_SCHEME=socks5
WB_PROXY=socks5://LOGIN:PASSWORD@HOST:PORT
# Или список:
# WB_PROXY_URLS=socks5://LOGIN:PASSWORD@HOST:PORT
# WB_SELLER_API_KEY=

# --- Competitor evidence enrichment (после ranking, только top-N) ---
# COMPETITOR_ENRICH_TOP_N=5
# COMPETITOR_ENRICH_TTL_SECONDS=21600
