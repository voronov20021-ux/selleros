# Local `npm run dev`: leave empty so Vite proxies /api, /dashboard, /health to :8000.
VITE_API_BASE=

# Local dev/preview: keep `/`. GitHub Actions sets `/<repo>/` for Pages.
VITE_BASE=/

# Vite DEV only. Production builds never call /api/auth/dev (import.meta.env.DEV is false).
# Set 0 to skip local DEV login even under `npm run dev`.
# VITE_MINIAPP_DEV_AUTH=1
